# Example values only. Copy to .env and enter your own local MySQL values.
# Java properties format: no export and no surrounding quotes.
# Escape a literal backslash as two backslashes.
DB_URL=jdbc:mysql://localhost:3306/redbeanz
DB_USERNAME=your_local_username
DB_PASSWORD=your_local_password

# Base64-encoded random signing key of at least 32 bytes. Required for the web server.
JWT_SECRET_BASE64=
# Optional comma-separated browser origins, for example http://localhost:5173
CORS_ALLOWED_ORIGINS=
